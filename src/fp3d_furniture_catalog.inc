float catalog_surface( kind shape )
{
    const auto *v = catalog_parts( shape );
    if( !v ) return 0.f;
    float low = 0.f;
    for( const auto &p : *v ) {
        if( p.top < 2.f && p.width > .25f && p.depth > .20f ) low = std::max( low, p.top );
    }
    return low;
}
bool catalog_has_front( kind shape ) {
    return catalog_parts( shape ) != nullptr && shape != kind::udp_mat && shape != kind::udp_pile &&
           shape != kind::udp_stack_short && shape != kind::udp_stack_mid && shape != kind::udp_stack_tall;
}
bool catalog_storage( kind shape ) {
    return shape == kind::udp_safe || shape == kind::udp_cabinet || shape == kind::udp_crate;
}
